{
  "name": "giclaw",
  "type": "module",
  "version": "0.3.0",
  "packageManager": "pnpm@10.2.0",
  "description": "AI agent for Genshin Impact cloud gaming",
  "license": "MIT",
  "homepage": "https://giclaw.cn",
  "repository": {
    "type": "git",
    "url": "https://github.com/caterpi11ar/giclaw.git"
  },
  "keywords": [
    "genshin-impact",
    "ai-agent",
    "cloud-gaming",
    "automation",
    "playwright"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./plugin-sdk": {
      "types": "./dist/plugin-sdk/index.d.ts",
      "default": "./dist/plugin-sdk/index.js"
    },
    "./plugin-sdk/channel-ingress-runtime": {
      "types": "./dist/plugin-sdk/inbound.d.ts",
      "default": "./dist/plugin-sdk/inbound.js"
    },
    "./plugin-sdk/channel-plugin-common": {
      "types": "./dist/plugin-sdk/index.d.ts",
      "default": "./dist/plugin-sdk/index.js"
    },
    "./plugin-sdk/config-contracts": {
      "types": "./dist/plugins/config-contracts.d.ts",
      "default": "./dist/plugins/config-contracts.js"
    },
    "./plugin-sdk/plugin-entry": {
      "types": "./dist/plugin-sdk/definitions.d.ts",
      "default": "./dist/plugin-sdk/definitions.js"
    },
    "./plugin-sdk/types": {
      "types": "./dist/plugins/types.d.ts",
      "default": "./dist/plugins/types.js"
    }
  },
  "bin": {
    "giclaw": "dist/cli.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "node scripts/prepare-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-plugin-assets.mjs && cp -r src/web/public dist/web/public && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "start:daemon": "node dist/cli.js daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:package": "node scripts/check-package.mjs",
    "test:feishu": "tsx scripts/feishu-e2e.mjs",
    "docs:dev": "pnpm --dir docs start",
    "docs:build": "pnpm --dir docs build",
    "docs:serve": "pnpm --dir docs serve",
    "lint": "eslint --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@inquirer/prompts": "^8.5.2",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@midscene/shared": "1.10.9",
    "@midscene/web": "1.10.9",
    "@playwright/test": "^1.62.1",
    "commander": "^12.1.0",
    "fastify": "^5.11.2",
    "gray-matter": "^4.0.3",
    "imapflow": "1.7.8",
    "ink": "^4.4.1",
    "mailauth": "5.0.3",
    "mailparser": "3.9.20",
    "node-cron": "^4.6.0",
    "ora": "^9.4.1",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.0",
    "tsx": "^4.23.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "@midscene/core>js-yaml": "4.3.1",
      "@midscene/shared>sharp": "0.35.3",
      "body-parser": "1.20.6",
      "engine.io": "6.6.9",
      "express": "4.22.2",
      "express>path-to-regexp": "0.1.13",
      "fast-uri": "3.1.5",
      "find-my-way": "9.7.0",
      "follow-redirects": "1.16.0",
      "gray-matter>js-yaml": "3.15.1",
      "ip-address": "10.4.0",
      "lodash": "4.18.1",
      "minimatch@10.2.6>brace-expansion": "5.0.9",
      "minimatch@9.0.9>brace-expansion": "2.1.4",
      "qs": "6.15.3",
      "socket.io-parser": "4.2.7",
      "uuid": "11.1.1",
      "ws": "8.21.2"
    }
  }
}
